# ── LLM provider ─────────────────────────────────────────────────────────
GEMINI_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash

# ── Qdrant ───────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=3gpp_standards

# ── Embeddings ───────────────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Chunks embedded per forward pass during ingestion. Larger = faster on GPU
# but uses more VRAM; on CPU keep it modest. Default 16.
EMBEDDING_BATCH_SIZE=16

# ── Corpus control ───────────────────────────────────────────────────────
# MVP is frozen to Rel-18. Do not change without updating configs/corpus.yaml.
TARGET_RELEASE=Rel-18

# ── Retrieval tuning (starting values — see SRD §28, calibrate later) ────
DENSE_TOP_K=20
SPARSE_TOP_K=20
FUSED_TOP_K=30
RERANK_TOP_K=8
EVIDENCE_SCORE_THRESHOLD=0.35

# ── App ──────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
